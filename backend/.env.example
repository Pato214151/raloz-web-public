# ============================================
# RALOZ WEB - Configuración de Entorno
# ============================================
# Copiar este archivo como .env y llenar los valores

# Flask
FLASK_ENV=development
SECRET_KEY=cambiar-por-una-clave-segura-de-64-caracteres
JWT_SECRET_KEY=otra-clave-segura-diferente-de-64-caracteres

# Base de datos PostgreSQL (Supabase)
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT_REF].supabase.co:5432/postgres

# Google OAuth 2.0
GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=tu-client-secret

# CORS - Dominios permitidos (separados por coma)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Rate Limiting
RATELIMIT_STORAGE_URI=memory://

# App
APP_NAME=RALOZ COL SAS
FRONTEND_URL=http://localhost:5173
