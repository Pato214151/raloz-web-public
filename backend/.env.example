# ============================================================
# RALOZ COL SAS — Plantilla de variables de entorno
# ============================================================
# Copia este archivo como .env y completa los valores reales:
#   cp .env.example .env
# ============================================================

# Base de datos Supabase (PostgreSQL)
DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/db_name

# Seguridad
SECRET_KEY=cambia-por-una-clave-segura
JWT_SECRET_KEY=cambia-por-otra-clave-segura

# MercadoPago (producción: APP_USR-... | prueba: APP_USR-... de la app sandbox)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxx
# MEJORA #2: Webhook Secret para validar firma de MP
# Se obtiene en MercadoPago Dashboard → Webhooks → Secret
MP_WEBHOOK_SECRET=tu-webhook-secret-aqui

# URLs
MP_REDIRECT_URL=https://ralozcolsas.com
BACKEND_URL=https://raloz-web.onrender.com

# CORS — dominios que pueden llegar al backend (separados por coma)
CORS_ORIGINS=https://ralozcolsas.com,https://www.ralozcolsas.com,https://ralozcol-web.pages.dev

# Email (Gmail SMTP) — para enviar factura PDF al cliente tras pago exitoso
# 1. Activa verificación en 2 pasos en tu cuenta Gmail
# 2. Ve a Cuenta Google → Seguridad → Contraseñas de aplicación
# 3. Genera una contraseña de 16 chars para "Correo / Otro (nombre personalizado)"
# 4. Pon esa contraseña aquí (NO tu contraseña normal de Gmail)
EMAIL_REMITENTE=tu_correo@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_NOMBRE=RALOZ COL SAS

# ============================================================
# Avisos por WhatsApp (bot OpenWA) — opcional
# Si se dejan vacíos, el backend NO intenta enviar avisos (seguro).
# WHATSAPP_BOT_URL   = URL pública del bot (donde corre OpenWA + bot.py)
# WHATSAPP_BOT_TOKEN = mismo valor que NOTIFY_TOKEN en el bot
# ============================================================
WHATSAPP_BOT_URL=
WHATSAPP_BOT_TOKEN=

# (Opcional) WhatsApp del admin para alertas internas (ej: posible doble pago de saldo)
# Formato: numero (ej: 573213412903)
ADMIN_WHATSAPP=

# ============================================================
# Mantenimiento semanal automatizado (tools/maintenance.py)
# Si cualquiera de estas falta, el weekly maintenance sigue
# corriendo (backup + diagnóstico + retención) pero OMITE el
# email final. Configúralas si quieres avisos automáticos.
# ============================================================
# Brevo (mismas vars que ya usas para mandar facturas a clientes)
BREVO_API_KEY=
# EMAIL_REMITENTE + EMAIL_NOMBRE ya están más arriba para facturas
# Destinatario de los avisos internos de mantenimiento
EMAIL_AVISO_TO=

