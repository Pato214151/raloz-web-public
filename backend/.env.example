# ============================================================
# RALOZ COL SAS — Plantilla de variables de entorno
# ============================================================
# Copia este archivo como .env y completa los valores reales:
#   cp .env.example .env
# ============================================================

# Base de datos Supabase (PostgreSQL)
DATABASE_URL=postgresql+psycopg://usuario:password@host:5432/db_name

# Seguridad
SECRET_KEY=cambia-por-una-clave-segura
JWT_SECRET_KEY=cambia-por-otra-clave-segura

# MercadoPago (producción: APP_USR-... | prueba: APP_USR-... de la app sandbox)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
MP_PUBLIC_KEY=APP_USR-xxxxxxxx

# URLs
MP_REDIRECT_URL=https://ralozcol-web.pages.dev
BACKEND_URL=https://raloz-web.onrender.com

# CORS — dominios que pueden llegar al backend (separados por coma)
CORS_ORIGINS=https://ralozcol-web.pages.dev

# Email (Gmail SMTP) — para enviar factura PDF al cliente tras pago exitoso
# 1. Activa verificación en 2 pasos en tu cuenta Gmail
# 2. Ve a Cuenta Google → Seguridad → Contraseñas de aplicación
# 3. Genera una contraseña de 16 chars para "Correo / Otro (nombre personalizado)"
# 4. Pon esa contraseña aquí (NO tu contraseña normal de Gmail)
EMAIL_REMITENTE=tu_correo@gmail.com
EMAIL_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_NOMBRE=RALOZ COL SAS
